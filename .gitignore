# === Binaries (re-installable) ===
node/

# === Cloned upstream repo (has own .git, 1.5G) ===
hermes-agent/

# === Cron output (noisy, re-creatable) ===
cron/output/

# === Syncthing internals ===
.stfolder/
.stignore
*.sync-conflict-*
*.syncthing.*.tmp

# === Python / Node ===
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# === OS ===
.DS_Store
Thumbs.db

# === Timestamped backups (re-creatable; auth.json.bak held live creds — leak fixed 2026-05-24) ===
*.bak
*.bak.*
*.bak-*
*.after-sync

# Additional runtime/noisy state exclusions
**/cron/output/

# Log exclusions at any profile depth
**/logs/
**/.npm/_logs/
*.log

# OAuth/API credentials at profile depth (NEVER commit)
**/google_token.json
**/google_client_secret.json
**/google_oauth_pending.json
**/oauth_token.json
**/*token*.json
**/*client_secret*.json
**/*oauth_pending*.json
shared/nous_auth.json

# === Life OS knowledge base: authoritative data, MUST be backed up ===
# The generic runtime patterns above (**/logs/, checkpoints/) were written for
# Hermes runtime noise. They silently excluded Life OS's source-of-truth records
# while its rebuildable SQLite cache stayed committed - exactly inverted.
# Re-include them explicitly; parent dirs are not excluded, so these negations bind.
!projects/life-os/life-knowledge-base/**/logs/
!projects/life-os/verification/checkpoints/
# SQLite transients: committing these beside the .sqlite3 yields an inconsistent restore
*.sqlite3-wal
*.sqlite3-shm
# Checkpoint copies of the ledgers carry the same directory names; the negation above is
# anchored under life-knowledge-base/ only, so cover the checkpointed copies too.
!projects/life-os/verification/checkpoints/**/logs/

# agentmemory npm cache (re-creatable noise)
agentmemory/npm-cache/
**/npm-cache/

# Update mutex / transient locks
.hermes-update-in-progress.mutex
*.mutex

# desktop-ssh ephemeral sessions (permission-restricted)
desktop-ssh/
